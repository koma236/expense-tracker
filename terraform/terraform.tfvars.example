# terraform.tfvars のサンプル。
# 実値を入れた terraform.tfvars はコミットしないこと（.gitignore 済み）。
#
# 使い方:
#   cp terraform.tfvars.example terraform.tfvars
#   # 値を編集してから terraform plan / apply

# SSH(22) を許可する CIDR。自分のグローバルIP/32 を指定する。
# 現在のIPは `curl -s https://checkip.amazonaws.com` で確認可能。
ssh_cidr = "203.0.113.10/32"

# RDS マスターパスワード（8文字以上の強力な値）
db_password = "CHANGE_ME_strong_password"

# 必要に応じて上書き（既定値あり）
# aws_region        = "ap-northeast-1"
# key_name          = "my-aws-key"
# instance_type     = "t3.micro"
# db_instance_class = "db.t3.micro"
