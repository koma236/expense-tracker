# Go API（ExpenseTracker バックエンド）の systemd ユニット。
#
# 配置先: /etc/systemd/system/expense-tracker-api.service
# 前提:
#   - ビルド済みバイナリ: /usr/local/bin/expense-tracker-api
#   - 環境変数ファイル:   /etc/expense-tracker/api.env（deploy/api.env.example を参照）
#
# 有効化（EC2 起動時に自動起動するよう enable する）:
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now expense-tracker-api
#   sudo systemctl status expense-tracker-api
#   journalctl -u expense-tracker-api -f   # ログ確認

[Unit]
Description=ExpenseTracker Go API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
EnvironmentFile=/etc/expense-tracker/api.env
ExecStart=/usr/local/bin/expense-tracker-api
Restart=always
RestartSec=3
# 標準出力/標準エラーを journald に集約（journalctl で参照可能）
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
