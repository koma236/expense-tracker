# 本番 Go API 用の環境変数サンプル。
#
# 配置先: /etc/expense-tracker/api.env
# 作成手順:
#   sudo mkdir -p /etc/expense-tracker
#   sudo cp deploy/api.env.example /etc/expense-tracker/api.env
#   sudo nano /etc/expense-tracker/api.env   # 値を実環境に合わせて編集
#   sudo chmod 640 /etc/expense-tracker/api.env   # DBパスワードを含むため権限を絞る
#
# 注意: このファイル自体（.example）はサンプルなのでコミット可。
#       実値を入れた api.env は絶対にコミットしないこと。

# アプリ
APP_PORT=8080
TZ=Asia/Tokyo

# データベース（RDS のエンドポイントと認証情報）
DB_HOST=expense-tracker-db.xxxxxxxx.ap-northeast-1.rds.amazonaws.com
DB_PORT=3306
DB_NAME=expense_tracker
DB_USER=app
DB_PASSWORD=__SET_A_STRONG_PASSWORD__

# CORS: フロントと同一オリジン（nginx 配信）のため通常は不要。
# 別オリジンから API を叩く場合のみ、許可するオリジンを設定する。
# CORS_ALLOW_ORIGIN=http://<EC2のパブリックDNS>
